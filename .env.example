# --- основное ---
PORT=3000
APP_URL=https://payout.example          # публичный адрес: ссылки в письмах и проверка документов
BRAND=PayOut
DB_PATH=/data/payout.db
DEMO_MODE=0                             # 0 — боевой режим: нет кодов на экране, нет эмуляции оплаты
SEED=0                                  # не создавать демо-данные
# --- безопасность ---
COOKIE_SECURE=1                         # cookie только по HTTPS + HSTS
TRUST_PROXY=1                           # брать IP из X-Forwarded-For (за nginx)
SESSION_DAYS=14
# --- SMS (sms.ru) ---
SMS_PROVIDER=smsru
SMSRU_API_ID=
# --- Email (Unisender Go) ---
EMAIL_PROVIDER=unisender
UNISENDER_API_KEY=
EMAIL_FROM=noreply@payout.example
# --- оператор (для счетов) ---
OPERATOR_NAME=ООО «ПэйАут»
OPERATOR_REQUISITES=р/с 40702… в АО «Банк», БИК …, номинальный счёт
# --- банк ---
BANK_PROVIDER=demo                      # подключить адаптер банка в server/services.js (bank.transfer)
# --- резервные копии ---
BACKUP_DIR=/data/backups
BACKUP_KEEP=7
LOG_REQUESTS=1

# --- тестовый стенд ---
HOST=127.0.0.1
SITE_PASSWORD=                          # закрыть стенд паролем (пусто — открыт)
